alert tcp 10.10.40.0/24 any -> $HOME_NET any (msg:"LAB possible TCP SYN scan"; flags:S; threshold:type both, track by_src, count 5, seconds 10; classtype:network-scan; sid:1000001; rev:1;)
alert http 10.10.40.0/24 any -> $HOME_NET any (msg:"LAB suspicious HTTP enumeration"; flow:established,to_server; http.uri; content:"/lab-suspicious"; classtype:web-application-attack; sid:1000002; rev:1;)
drop http 10.10.40.0/24 any -> 10.10.20.10 80 (msg:"LAB IPS blocked HTTP request"; flow:established,to_server; http.uri; content:"/blocked-by-ips"; classtype:web-application-attack; sid:1000003; rev:1;)
